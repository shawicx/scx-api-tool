"import { z } from 'zod';
import { PetSchema } from '../schemas/PetSchema';
import { PetStatusSchema } from '../schemas/PetStatusSchema';
import { PetListResponseSchema } from '../schemas/PetListResponseSchema';
import { CreatePetRequestSchema } from '../schemas/CreatePetRequestSchema';

/**
 * @description 查询宠物详情
 */
export const GetPetsByPetIdRequestTypeSchema = z.object({
  petId: z.number(),
});

/**
 * @description 查询宠物详情
 */
export const GetPetsByPetIdResultTypeSchema = PetSchema;

// 推导类型
export type GetPetsByPetIdRequestType = z.infer<
  typeof GetPetsByPetIdRequestTypeSchema
>;
export type GetPetsByPetIdResultType = z.infer<
  typeof GetPetsByPetIdResultTypeSchema
>;

/**
 * @description 删除宠物
 */
