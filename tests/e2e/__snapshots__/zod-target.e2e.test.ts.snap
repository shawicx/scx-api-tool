  petId: z.number(),
});

/**
 * @description 删除宠物
 */
export const DeletePetsByPetIdResultTypeSchema = z.object({});

// 推导类型
export type DeletePetsByPetIdRequestType = z.infer<
  typeof DeletePetsByPetIdRequestTypeSchema
>;
export type DeletePetsByPetIdResultType = z.infer<
  typeof DeletePetsByPetIdResultTypeSchema
>;

/**
 * @description 分页查询宠物列表
 */
export const GetPetsRequestTypeSchema = z.object({
  page: z.number(),
  pageSize: z.number(),
  status: PetStatusSchema,
});

/**
 * @description 分页查询宠物列表
 */
export const GetPetsResultTypeSchema = PetListResponseSchema;

// 推导类型
export type GetPetsRequestType = z.infer<typeof GetPetsRequestTypeSchema>;
export type GetPetsResultType = z.infer<typeof GetPetsResultTypeSchema>;

/**
 * @description 创建宠物
 */
export const PostPetsRequestTypeSchema = CreatePetRequestSchema;

/**
 * @description 创建宠物
 */
