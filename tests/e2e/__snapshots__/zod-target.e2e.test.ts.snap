export type PostPetsResultType = z.infer<typeof PostPetsResultTypeSchema>;

/**
 * @description 上传宠物照片
 */
export const PostPetsPhotosByPetIdRequestTypeSchema = z.object({
  petId: z.number(),
  file: z.instanceof(File),
  caption: z.string().optional(),
});

/**
 * @description 上传宠物照片
 */
export const PostPetsPhotosByPetIdResultTypeSchema = z.object({
  photoId: z.string(),
  url: z.string(),
});

// 推导类型
