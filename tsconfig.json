{
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": false,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "removeComments": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "newLine": "LF",
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "paths": {
      "@scxfe/api-tool": ["./src/index.ts"],
      "@/*": ["./src/*"]
    },
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tsdown.config.ts",
    "api-power.config.ts",
    "docs/**/*",
    ".vitepress/**/*",
    ".vitepress/config.mts"
  ],
  "exclude": ["node_modules", "src/service/**/*", "assets/**/*"]
}
