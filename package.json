{
  "name": "@scxfe/api-tool",
  "version": "0.0.0",
  "description": "根据 swagger/yapi/apifox 的接口定义生成 TypeScript/JavaScript 的接口类型及其请求函数代码。",
  "keywords": [
    "yapi",
    "codegen",
    "typescript",
    "swagger",
    "apifox"
  ],
  "homepage": "https://github.com/shawicx/scx-api-tool#readme",
  "bugs": {
    "url": "https://github.com/shawicx/scx-api-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawicx/scx-api-tool.git"
  },
  "funding": "https://github.com/sponsors/shawicx",
  "license": "MIT",
  "author": {
    "name": "shawicx",
    "email": "d35f3153@proton.me",
    "url": "https://github.com/shawicx"
  },
  "sideEffects": false,
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.mjs",
  "types": "lib/esm/index.d.mts",
  "bin": {
    "apiPower": "lib/cjs/cli.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown",
    "ci:eslint": "eslint -f json src -o ./.ci/eslint.json",
    "docs": "npm run docs:build && gh-pages --dist docs/dist --dest handbook",
    "docs:build": "dumi build",
    "docs:dev": "dumi dev",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "postaction": "git push origin main --tags",
    "prepare": "husky",
    "prepublish": "tsdown",
    "publish": "changeset add && changeset version && changeset publish",
    "release": "pnpm run prepublish && pnpm run publish && pnpm run postaction"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx,vue}": "eslint --fix",
    "*.{cjs,css,cts,html,js,json,jsx,less,md,mjs,mts,scss,ts,tsx,vue,yaml,yml}": "prettier --write"
  },
  "prettier": "prettier-config-ali",
  "dependencies": {
    "@babel/runtime": "^7.13.10",
    "@types/json-schema": "^7.0.9",
    "axios": "^1.11.0",
    "change-case": "^3.0.2",
    "consola": "^2.3.0",
    "dayjs": "^1.8.32",
    "form-data": "^3.0.0",
    "fs-extra": "^7.0.1",
    "get-port": "^5.1.1",
    "json-schema-to-typescript": "^10.1.4",
    "json5": "^2.1.0",
    "lodash": "^4.17.21",
    "node-fetch": "^2",
    "ora": "^3.4.0",
    "prompts": "^2.0.4",
    "proxy-agent": "^5.0.0",
    "signal-exit": "^3.0.3",
    "swagger-client": "3.18.4",
    "tiny-pinyin": "^1.3.2",
    "to-json-schema": "^0.2.5",
    "traverse": "^0.6.11",
    "ts-dedent": "^2.2.0",
    "ts-node": "^8.0.2",
    "typescript": "^4.2.3",
    "yargs": "^16.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/fs-extra": "^5.0.4",
    "@types/json5": "^0.0.30",
    "@types/lodash": "^4.17.20",
    "@types/node": "^10.12.10",
    "@types/node-fetch": "^2.6.2",
    "@types/prompts": "^1.2.0",
    "@types/react": "^16.9.2",
    "@types/signal-exit": "^3.0.0",
    "@types/swagger-schema-official": "^2.0.21",
    "@types/to-json-schema": "^0.2.0",
    "@types/yargs": "^16.0.1",
    "dumi": "^1.1.10",
    "eslint": "^9.32.0",
    "eslint-config-ali": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "gh-pages": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "openapi-types": "^7.0.1",
    "prettier": "^3.6.2",
    "prettier-config-ali": "^1.3.4",
    "shx": "^0.3.2",
    "tempy": "^0.3.0",
    "ts-essentials": "^10.1.1",
    "tsdown": "^0.13.1",
    "type-fest": "^4.41.0",
    "typedoc": "^0.14.2"
  },
  "engines": {
    "node": ">=10.19.0"
  }
}
