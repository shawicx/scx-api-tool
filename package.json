{
  "name": "@scxfe/api-tool",
  "version": "0.4.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "根据 Swagger/OpenAPI 3.0 和 Apifox 的接口定义生成 TypeScript/JavaScript 的接口类型及其请求函数代码。",
  "keywords": [
    "codegen",
    "typescript",
    "swagger",
    "openapi",
    "apifox"
  ],
  "homepage": "https://github.com/shawicx/scx-api-tool#readme",
  "bugs": {
    "url": "https://github.com/shawicx/scx-api-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawicx/scx-api-tool.git"
  },
  "funding": "https://github.com/sponsors/shawicx",
  "license": "MIT",
  "author": {
    "name": "shawicx",
    "email": "d35f3153@proton.me",
    "url": "https://github.com/shawicx"
  },
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "bin": {
    "api-power": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts generate --config api-power.config.ts --watch",
    "build": "tsdown",
    "analyze:deps": "node scripts/analyze-deps.js",
    "ci:eslint": "eslint -f json src -o ./.ci/eslint.json",
    "docs": "pnpm run dumi build",
    "docs:build": "vitepress build",
    "docs:dev": "vitepress dev",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "postaction": "git push origin main --tags",
    "prepare": "husky",
    "prepublish": "pnpm run build",
    "versioning": "standard-version",
    "release": "pnpm run prepublish && pnpm run versioning && pnpm run postaction && pnpm publish",
    "docs:preview": "vitepress preview"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-case": [
        2,
        "always",
        [
          "lower-case",
          "upper-case"
        ]
      ],
      "type-enum": [
        2,
        "always",
        [
          "RELEASING",
          "feat",
          "fix",
          "docs",
          "style",
          "test",
          "refactor",
          "chore",
          "revert"
        ]
      ]
    }
  },
  "lint-staged": {
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx,vue}": "eslint --fix",
    "*.{cjs,css,cts,html,js,json,jsx,less,md,mjs,mts,scss,ts,tsx,vue,yaml,yml}": "prettier --write"
  },
  "prettier": "prettier-config-ali",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "axios": "^1.11.0",
    "change-case": "3.1.0",
    "commander": "^14.0.0",
    "consola": "^3.4.2",
    "dayjs": "^1.11.13",
    "form-data": "^4.0.4",
    "fs-extra": "^11.3.1",
    "handlebars": "^4.7.8",
    "json-schema-to-typescript": "^15.0.4",
    "json5": "^2.2.3",
    "lodash-es": "^4.17.21",
    "pinyin-pro": "^3.27.0",
    "proxy-agent": "^6.5.0",
    "signal-exit": "^4.1.0",
    "swagger-client": "^3.35.6",
    "to-json-schema": "^0.2.5",
    "traverse": "^0.6.11",
    "ts-dedent": "^2.2.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/fs-extra": "^5.0.4",
    "@types/json-schema": "^7.0.9",
    "@types/json5": "^0.0.30",
    "@types/lodash": "^4.17.20",
    "@types/node": "^10.12.10",
    "@types/prompts": "^1.2.0",
    "@types/react": "^16.9.2",
    "@types/signal-exit": "^3.0.0",
    "@types/swagger-schema-official": "^2.0.21",
    "@types/to-json-schema": "^0.2.0",
    "eslint": "^9.32.0",
    "eslint-config-ali": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "gh-pages": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "openapi-types": "^7.0.1",
    "prettier": "^3.6.2",
    "prettier-config-ali": "^1.3.4",
    "shx": "^0.3.2",
    "standard-version": "^9.5.0",
    "tempy": "^0.3.0",
    "ts-essentials": "^10.1.1",
    "tsdown": "^0.13.1",
    "tsx": "^4.20.5",
    "type-fest": "^4.41.0",
    "typedoc": "^0.14.2",
    "typescript": "^5.9.2",
    "vitepress": "2.0.0-alpha.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
