{
  "name": "@scxfe/api-tool",
  "version": "0.6.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "根据 Swagger/OpenAPI 3.0 和 Apifox 的接口定义生成 TypeScript/JavaScript 的接口类型及其请求函数代码。",
  "keywords": [
    "codegen",
    "typescript",
    "swagger",
    "openapi",
    "apifox"
  ],
  "homepage": "https://github.com/shawicx/scx-api-tool#readme",
  "bugs": {
    "url": "https://github.com/shawicx/scx-api-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawicx/scx-api-tool.git"
  },
  "funding": "https://github.com/sponsors/shawicx",
  "license": "MIT",
  "author": {
    "name": "shawicx",
    "email": "d35f3153@proton.me",
    "url": "https://github.com/shawicx"
  },
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "bin": {
    "api-power": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli/main.ts generate --config api-power.config.ts",
    "build": "NODE_ENV=production tsdown",
    "analyze:deps": "node scripts/analyze-deps.js",
    "ci:eslint": "eslint -f json src -o ./.ci/eslint.json",
    "docs": "pnpm run dumi build",
    "docs:build": "vitepress build",
    "docs:dev": "vitepress dev",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "check:linesize": "find src -name '*.ts' -exec wc -l {} + | awk '$1 > 360 { print $2 \" (\" $1 \" lines)\" }'",
    "postaction": "git push origin main --tags && git push origin main --tags",
    "prepare": "husky",
    "prepublish": "pnpm run build",
    "versioning": "standard-version",
    "release": "pnpm run prepublish && pnpm run versioning && pnpm run postaction && pnpm publish",
    "docs:preview": "vitepress preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-case": [
        2,
        "always",
        [
          "lower-case",
          "upper-case"
        ]
      ],
      "type-enum": [
        2,
        "always",
        [
          "RELEASING",
          "feat",
          "fix",
          "docs",
          "style",
          "test",
          "refactor",
          "chore",
          "revert"
        ]
      ]
    }
  },
  "lint-staged": {
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx,vue}": "eslint --fix",
    "*.{cjs,css,cts,html,js,json,jsx,less,md,mjs,mts,scss,ts,tsx,vue,yaml,yml}": "prettier --write"
  },
  "prettier": "prettier-config-ali",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@scxfe/api-tool": "link:",
    "axios": "^1.19.0",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "handlebars": "^4.7.9",
    "pinyin-pro": "^3.29.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-ali": "^16.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-config-ali": "^1.5.0",
    "standard-version": "^9.5.0",
    "tsdown": "^0.13.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.15",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
