# Set default behavior to automatically normalize line endings
* text=auto

# Force bash scripts to always use LF line endings
*.sh text eol=lf

# Force batch scripts to always use CRLF line endings
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Text files that should use LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.vue text eol=lf
*.svelte text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.avi binary
*.mov binary
*.wmv binary
*.flv binary
*.webm binary
*.wav binary
*.aac binary
*.ogg binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary
*.pdf binary
*.sketch binary
*.psd binary
*.ai binary
*.eps binary

# JSON files with comments (for config files)
*.json linguist-language=JSON-with-Comments

# Documentation
*.md linguist-documentation
*.txt linguist-documentation

# Generated files
lib/ linguist-generated
dist/ linguist-generated
build/ linguist-generated
src/service/ linguist-generated

# Large files
*.lock linguist-vendored
pnpm-lock.yaml linguist-vendored
yarn.lock linguist-vendored
package-lock.json linguist-vendored
